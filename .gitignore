# --- Unreal Engine ---
Unreal/Binaries/
Unreal/Intermediate/
Unreal/Saved/
Unreal/DerivedDataCache/
Unreal/Build/
Unreal/.vs/
Unreal/.idea/
Unreal/*.sln
Unreal/*.VC.db
Unreal/*.VC.opendb
Unreal/Plugins/*/Binaries/
Unreal/Plugins/*/Intermediate/

# --- Blender ---
*.blend[0-9]
*.blend@

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# --- Pipeline : état local et sorties intermédiaires ---
pipeline/gpu.lock
audio/music/ace/
*.tmp
*.log

# --- Windows / WSL / éditeurs ---
*:Zone.Identifier
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Sorties régénérables par script (essais image → 3D) ---
assets/3d/
assets/spike/
audio/sfx/candidates/

# Vidéos copiées dans le projet pour l'empaquetage (régénérables)
Unreal/Content/Movies/

# Builds (APK, exécutables)
builds/

# Géométrie générée depuis le tracé (régénérée par build.py, volumineuse)
pipeline/layout/greybox.json
pipeline/layout/vegetation.json

# sprites peints : intermédiaires régénérables (pipeline/comfy/sprites.py)
assets/textures/sprites/**/*_brut.png
assets/textures/sprites/**/*_masque.png
assets/textures/sprites/**/essai_*.png

# Animatics vidéo : lourds et régénérables (pipeline/review/animatic.py) ; la planche-animatic.jpg reste versionnée.
review/**/animatic*.mp4

# Montages vidéo de l'article : régénérables (pipeline/article/montage.py) ; la planche fixe .jpg reste versionnée.
article/**/*.mp4
