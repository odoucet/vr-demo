{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "DiT (turbo = brouillon, sft = rendu)"},
    "inputs": {"unet_name": "acestep_v1.5_xl_turbo_bf16.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "Shift"},
    "inputs": {"model": ["1", 0], "shift": 3.0}
  },
  "3": {
    "class_type": "DualCLIPLoader",
    "_meta": {"title": "Encodeur 0.6B + LM compositeur 4B"},
    "inputs": {
      "clip_name1": "qwen_0.6b_ace15.safetensors",
      "clip_name2": "qwen_4b_ace15.safetensors",
      "type": "ace",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "VAE"},
    "inputs": {"vae_name": "ace_1.5_vae.safetensors"}
  },
  "5": {
    "class_type": "TextEncodeAceStepAudio1.5",
    "_meta": {"title": "Composition (LM) : seed LM = la composition"},
    "inputs": {
      "clip": ["3", 0],
      "tags": "",
      "lyrics": "[Instrumental]",
      "seed": 0,
      "bpm": 72,
      "duration": 220.0,
      "timesignature": "4",
      "language": "en",
      "keyscale": "D major",
      "generate_audio_codes": true,
      "cfg_scale": 2.0,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0.0
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "Négatif"},
    "inputs": {"conditioning": ["5", 0]}
  },
  "7": {
    "class_type": "EmptyAceStep1.5LatentAudio",
    "_meta": {"title": "Latent"},
    "inputs": {"seconds": 220.0, "batch_size": 1}
  },
  "8": {
    "class_type": "KSampler",
    "_meta": {"title": "Rendu (DiT)"},
    "inputs": {
      "model": ["2", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecodeAudio",
    "_meta": {"title": "Décodage"},
    "inputs": {"samples": ["8", 0], "vae": ["4", 0]}
  },
  "10": {
    "class_type": "SaveAudio",
    "_meta": {"title": "Sortie FLAC"},
    "inputs": {"audio": ["9", 0], "filename_prefix": "vr-demo/music/draft"}
  }
}
